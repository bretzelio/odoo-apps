<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_cost_tax" model="ir.ui.view">
        <field name="name">product.template.form.cost.tax</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='supplier_taxes_id']" position="replace">
                <label for="supplier_taxes_id"/>
                <div class="o_row">
                    <field name="supplier_taxes_id"
                           nolabel="1"
                           widget="many2many_tax_tags"
                           class="oe_inline"
                           context="{'default_type_tax_use':'purchase', 'search_default_purchase': 1, 'search_default_service': type == 'service', 'search_default_goods': type == 'consu', 'search_default_domestictax': 1, 'append_fields': ['company_id'],}"/>
                    <field name="cost_tax_string" class="oe_inline"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
